from selenium.webdriver.common.by import By
from tests.fixtures.driver import driver

def test_compra_produto_com_sucesso(driver):

    # =========================
    # 1. LOGIN
    # =========================

    driver.get("https://www.saucedemo.com")
    driver.find_element(By.ID, "user-name").send_keys("standard_user")
    driver.find_element(By.ID, "password").send_keys("secret_sauce")
    driver.find_element(By.ID, "login-button").click()

    # =========================
    # 2. ADICIONAR PRODUTO
    # =========================

    driver.find_element(By.ID, "add-to-cart-sauce-labs-backpack").click()

    # =========================
    # 3. ACESSAR CARRINHO
    # =========================

    driver.find_element(By.CLASS_NAME, "shopping_cart_link").click()

    # =========================
    # 4. INICIAR CHECKOUT
    # =========================

    driver.find_element(By.ID, "checkout").click()

    # =========================
    # 5. INFORMAR DADOS
    # =========================

    driver.find_element(By.ID, "first-name").send_keys("Joao")
    driver.find_element(By.ID, "last-name").send_keys("Silva")
    driver.find_element(By.ID, "postal-code").send_keys("12345678")
    driver.find_element(By.ID, "continue").click()

    # Validacao checkout iniciado com sucesso
    assert "checkout-step-two.html" in driver.current_url